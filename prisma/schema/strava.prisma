enum SyncStatus {
  SYNCED
  SYNCING
  ERROR
  DISCONNECTED
}

model StravaIntegration {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @unique @map("user_id") @db.Uuid
  stravaAthleteId BigInt    @unique @map("strava_athlete_id")
  accessToken    String     @map("access_token")
  refreshToken   String     @map("refresh_token")
  expiresAt      DateTime   @map("expires_at") @db.Timestamptz
  scope          String     @map("scope")
  status         SyncStatus @default(DISCONNECTED) @map("status")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  lastSyncTime   DateTime?  @map("last_sync_time") @db.Timestamptz
  lastSyncStatus String?    @map("last_sync_status")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("strava_integrations")
}