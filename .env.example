# Database Configuration (Supabase PostgreSQL)
# DATABASE_URL: Transaction pooler port 6543 (used by app runtime)
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct connection port 5432 (used by Prisma CLI for migrations / db push)
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Application Server Port
PORT=3000

# Supabase Auth & Storage API Keys
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_SECRET="your-supabase-secret"

# External Email & Integrations
RESEND_KEY="your-resend-api-key"
GOOGLE_APP_PASSWORD="your-google-app-password"
